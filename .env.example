# 複製這個檔案為 .env 後填入實際值：cp .env.example .env

# 必填 -----------------------------------------------------------------

# GitHub Personal Access Token（fine-grained，至少要有目標 repo 的
# Issues: Read and write 權限），用來讀取 issue 內容、寫回留言
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# 要監聽的 repo，格式 owner/repo
GITHUB_REPO=your-username/your-demo-repo

# GitHub Webhook Secret：建立 webhook 時自訂的一組密鑰，
# 用來驗證 X-Hub-Signature-256（取得/設定位置：
# repo → Settings → Webhooks → Add webhook → Secret）
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string

# 選填 -----------------------------------------------------------------

# 觸發用的 label 名稱（issue 被貼上這個 label 時才會觸發）
TRIGGER_LABEL=ready-for-test

# claude 執行中途無輸出超過此分鐘數則強制終止（預設 5）
IDLE_TIMEOUT_MIN=5

# 啟動後等待第一行輸出的逾時秒數（預設 120）
STARTUP_TIMEOUT_SEC=120

# 覆寫 `which claude` 解析出的路徑，可指向 mock script 供測試使用
CLAUDE_PATH_OVERRIDE=

# ngrok authtoken + static domain，本機測試時建立對外 tunnel 用
# （沒有的話也可以用 smee.io 或直接部署到有公開網址的主機）
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# 設為 1 時關閉實際的 GitHub 留言寫入（改用 console.log），方便本機測試
TEST_MODE=0
